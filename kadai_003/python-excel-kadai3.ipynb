import pandas as pd
from openpyxl import load_workbook
from openpyxl.styles import PatternFill

# ① Excelファイルの読み込み

file1 = "2022_年間売上表.xlsx"
file2 = "2023_年間売上表.xlsx"

df1 = pd.read_excel(file1, sheet_name="Sheet1")
df2 = pd.read_excel(file2, sheet_name="Sheet1")


# ② データの連結

df = pd.concat([df1, df2], ignore_index=True)


# ③ グループ化して集計
# 「商品」「売上年」ごとに合計

grouped_df = df.groupby(["商品", "売上年"], as_index=False)["金額（千円）"].sum()


# ④ 新しいExcelファイルに書き込み

output_file = "売上集計表.xlsx"
grouped_df.to_excel(output_file, index=False)


# ⑤ ヘッダーを薄いグレーに設定

wb = load_workbook(output_file)
ws = wb.active

# 薄いグレーの色設定
fill = PatternFill(start_color="F2F2F2", end_color="F2F2F2", fill_type="solid")

# 1行目（ヘッダー）に色をつける
for cell in ws[1]:
    cell.fill = fill

# 保存
wb.save(output_file)